# Copy to .env when running the API outside Docker (uvicorn / alembic on your host).
# `docker compose up` does not read these two URLs; compose wires the API itself.

# Async SQLAlchemy URL (asyncpg). Matches the postgres service in docker-compose.yml,
# so `docker compose up -d postgres redis` + this file works out of the box.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentmemory

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional
DEBUG=false
TRUST_CACHE_TTL_SECONDS=60
SESSION_WRITES_CACHE_TTL_SECONDS=3600

# Host ports used by docker-compose.yml (change if something else already uses them)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# FRONTEND_PORT=3000
